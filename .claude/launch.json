{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@open-event-db/web", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@open-event-db/api", "dev"],
      "port": 3001
    },
    {
      "name": "api-identity",
      "runtimeExecutable": "env",
      "runtimeArgs": ["DATABASE_URL=postgres://oedb:oedb@localhost:5432/oedb_identity", "pnpm", "--filter", "@open-event-db/api", "dev"],
      "port": 3001
    }
  ]
}
