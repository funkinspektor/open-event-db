# PostgreSQL — matches docker-compose.yml
DATABASE_URL=postgres://oedb:oedb@localhost:5432/oedb

# Fastify API
API_PORT=3001
API_HOST=0.0.0.0

# Email (Lettermint primary, Scaleway TEM fallback)
LETTERMINT_API_KEY=

# Web → API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth
# Public URL of the web app (magic-link redirects land here)
WEB_URL=http://localhost:3000
# Public URL of the API (magic-link verify links point here)
API_PUBLIC_URL=http://localhost:3001
# Allowed browser origin for CORS (defaults to reflecting the request origin in dev)
CORS_ORIGIN=http://localhost:3000
# Email transport: console (dev, prints links to the API log). Lettermint adapter to follow.
EMAIL_PROVIDER=console
