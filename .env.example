# PostgreSQL — matches docker-compose.yml
DATABASE_URL=postgres://oedb:oedb@localhost:5432/oedb

# Fastify API
API_PORT=3001
API_HOST=0.0.0.0

# Web → API
# Browser → API. Compiled into the client bundle: a build arg for Dockerfile.web, not a runtime variable.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side rendering → API (optional, defaults to NEXT_PUBLIC_API_URL)
# API_URL=

# Auth
# Public URL of the web app (magic-link redirects land here)
WEB_URL=http://localhost:3000
# Public URL of the API (magic-link verify links point here)
API_PUBLIC_URL=http://localhost:3001
# Allowed browser origin for CORS (defaults to reflecting the request origin in dev)
CORS_ORIGIN=http://localhost:3000
# Production only, set on API *and* web: parent domain for the session cookie, so the web server on
# kellerkompass.de sees the cookie that api.kellerkompass.de sets. Leave empty locally.
# COOKIE_DOMAIN=kellerkompass.de

# Production
# API behind a load balancer: take the client IP from X-Forwarded-For (true or a hop count)
# TRUST_PROXY=true
# Shared secret (API + web) that exempts server-side rendering from the per-IP rate limit.
# Generate with: openssl rand -hex 32
# API_INTERNAL_TOKEN=
# Secret for POST /internal/ingest/run (daily feed import, sent as X-Ingest-Secret by the cron trigger).
# Unset or empty: the endpoint answers 404. Generate with: openssl rand -hex 32
# INGEST_CRON_SECRET=
# Web staging gate: Basic Auth for every page ("user:password") and an X-Robots-Tag noindex header
# BASIC_AUTH=
# SITE_NOINDEX=true
# Email transport: console (prints links to the API log) or scaleway (Scaleway Transactional Email).
# Automated tests always use console. With scaleway outside production, links are printed as well,
# and reserved domains (.example, .test, .local, ...) like the seed publishers' are never mailed.
EMAIL_PROVIDER=console
# Scaleway TEM (only for EMAIL_PROVIDER=scaleway). The sender domain must be verified in Scaleway.
# Not named SCW_*: Serverless Containers reserve that prefix.
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_REGION=fr-par
EMAIL_FROM=noreply@your-domain.example
EMAIL_FROM_NAME=Kellerkompass

# Event Capture (image → draft). Uses SCALEWAY_SECRET_KEY / SCALEWAY_PROJECT_ID above; the key's IAM policy
# needs GenerativeApisModelAccess. Leave VISION_MODEL empty to disable POST /api/v1/events/extract.
# Compare models with: pnpm --filter @open-event-db/api eval:extract <folder>
VISION_MODEL=mistral-medium-3.5-128b

# Production database for scripts/prod-db.sh (admin CLI / migrations from a laptop). No password here —
# the script asks for it on every run.
# PROD_DB_HOST=
# PROD_DB_PORT=
# PROD_DB_USER=
# PROD_DB_NAME=rdb

# Event images. Without S3_BUCKET, development stores them in .data/images (or IMAGE_DIR) and the API serves
# them at http://localhost:3001/images; production without a bucket has no event images.
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# IMAGE_BASE_URL=https://<bucket>.s3.fr-par.scw.cloud
