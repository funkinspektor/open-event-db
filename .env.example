# PostgreSQL — matches docker-compose.yml
DATABASE_URL=postgres://oedb:oedb@localhost:5432/oedb

# Fastify API
API_PORT=3001
API_HOST=0.0.0.0

# Web → API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth
# Public URL of the web app (magic-link redirects land here)
WEB_URL=http://localhost:3000
# Public URL of the API (magic-link verify links point here)
API_PUBLIC_URL=http://localhost:3001
# Allowed browser origin for CORS (defaults to reflecting the request origin in dev)
CORS_ORIGIN=http://localhost:3000
# Email transport: console (prints links to the API log) or scaleway (Scaleway Transactional Email).
# Automated tests always use console. With scaleway outside production, links are printed as well,
# and reserved domains (.example, .test, .local, ...) like the seed publishers' are never mailed.
EMAIL_PROVIDER=console
# Scaleway TEM (only for EMAIL_PROVIDER=scaleway). The sender domain must be verified in Scaleway.
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_REGION=fr-par
EMAIL_FROM=noreply@your-domain.example
EMAIL_FROM_NAME=Kellerkompass

# Event Capture (image → draft). Uses SCW_SECRET_KEY / SCW_DEFAULT_PROJECT_ID above; the key's IAM policy
# needs GenerativeApisModelAccess. Leave VISION_MODEL empty to disable POST /api/v1/events/extract.
# Compare models with: pnpm --filter @open-event-db/api eval:extract <folder>
VISION_MODEL=mistral-medium-3.5-128b
