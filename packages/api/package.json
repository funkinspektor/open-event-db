{
  "name": "@open-event-db/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "tsx --env-file-if-exists=../../.env src/ingest/cli.ts",
    "eval:extract": "tsx --env-file-if-exists=../../.env src/extract/eval.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@open-event-db/db": "workspace:*",
    "@open-event-db/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.2.1",
    "ical.js": "^2.2.1",
    "parse5": "^8.0.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
